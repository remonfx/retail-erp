{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RetailCore POS",
  "version": "0.1.0",
  "identifier": "app.retailcore.pos",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build" },
  "app": {
    "windows": [{ "title": "RetailCore POS", "width": 1366, "height": 800, "fullscreen": false, "resizable": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https: http://localhost:4000; img-src 'self' data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis", "deb"], "icon": [] }
}
